{
  "name": "guion-studio",
  "version": "1.0.0",
  "description": "Punto G: preproducción de guiones, personajes, sinopsis, estructura, escaleta y tratamiento",
  "author": "Punto G",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.puntog.app",
    "productName": "Punto G",
    "files": ["main.js", "preload.js", "src/**/*", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
